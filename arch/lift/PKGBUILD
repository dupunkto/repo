# Maintainer: Robin Boers <axcelott@roblog.nl>
pkgname=lift
pkgdesc='Remote deployment manager for containers and static files'
pkgver=r480.c1c5be8
pkgrel=1
arch=('any')
url='https://geheimesite.nl'
license=('Unlicense')
depends=('bash' 'shellutils' 'go-yq' 'docker')
source=("dotfiles::git+https://git.dupunkto.org/meta/dotfiles.git")
b2sums=('SKIP')

pkgver() {
  cd dotfiles
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd dotfiles
  install -Dm755 bin/lift        "$pkgdir/usr/bin/lift"
  install -Dm755 bin/lift-remote "$pkgdir/usr/bin/lift-remote"
}
