# Maintainer: Robin Boers <axcelott@dupunkto.org>
pkgname=cipher
pkgdesc='Securely send passphrases and API keys'
pkgver=r26.48db851
pkgrel=1
arch=('any')
url='https://git.dupunkto.org/~dupunkto/cipher'
license=('Unlicense')
depends=('arg' 'curl' 'jq' 'nodejs' 'shellutils')
source=("cipher::git+https://git.dupunkto.org/~dupunkto/cipher.git")
b2sums=('SKIP')

pkgver() {
  cd cipher
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd cipher
  install -Dm755 bin/cipher "$pkgdir/usr/bin/cipher"
}
