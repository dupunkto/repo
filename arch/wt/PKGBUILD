# Maintainer: Robin Boers <axcelott@dupunkto.org>
pkgname=wt
pkgdesc='Git worktree manager'
pkgver=r485.4e1f5c6
pkgrel=1
arch=('any')
url='https://geheimesite.nl'
license=('Unlicense')
depends=('git' 'shellutils')
source=("dotfiles::git+https://git.dupunkto.org/meta/dotfiles.git")
b2sums=('SKIP')

pkgver() {
  cd dotfiles
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd dotfiles
  install -Dm755 bin/wt "$pkgdir/usr/bin/wt"
}
