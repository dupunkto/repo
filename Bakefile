#!/bin/bash

required openssl
required git

DIST="$(pwd)/dist"
CACHE="$(pwd)/tmp"
PUBLIC="$(pwd)/public"

SOURCES=(
  "dotfiles:meta/dotfiles:$CACHE/dotfiles"
  "cipher:dupunkto/cipher:$CACHE/cipher"
  "cheese:dupunkto/cheese:$CACHE/cheese"
)

URL=https://repo.dupunkto.org

export PACKAGER="Robin Boers <axcelott@dupunkto.org>"
export SIGNING_KEY=67129351629DE9FDD6382A22F3A58BE3EB77795B

if [ "$(uname)" = "Darwin" ]; then
  export PATH="$(brew --prefix coreutils)/libexec/gnubin:$PATH"
fi

p:version() {
  printf 'r%s.%s' \
    "$(git -C "$1" rev-list --count HEAD)" \
    "$(git -C "$1" rev-parse --short HEAD)"
}

p:commit() {
  git -C "$1" rev-parse HEAD
}

p:use() {
  for SPEC in "${SOURCES[@]}"; do
    IFS=: read -r SOURCE REMOTE CLONE <<< "$SPEC"
    [ "$SOURCE" = "$1" ] && return
  done

  err "unknown package source '$1'"
}

setup() {
  mkdir -p "$DIST"
  mkdir -p "$CACHE"

  for SPEC in "${SOURCES[@]}"; do
    IFS=: read -r SOURCE REMOTE CLONE <<< "$SPEC"
    setup:clone "du:$REMOTE" "$CLONE"
  done
}

setup:clone() {
  remote=$1
  clone=$2

  if [ -d "$clone/.git" ]; then
    git -C "$clone" pull -q
  else
    git clone -q "$remote" "$clone"
  fi
}

clean() {
  rm -rf "$DIST"
  rm -rf "$CACHE"
}

manifest() {
  echo "==> Building manifests"
  manifest:gentoo
}

release() {
  setup

  p:use dotfiles
  DOTFILES_VERSION="$(p:version "$CLONE")"
  DOTFILES_COMMIT="$(p:commit "$CLONE")"

  p:use cipher
  CIPHER_VERSION="$(p:version "$CLONE")"
  CIPHER_COMMIT="$(p:commit "$CLONE")"

  p:use cheese
  CHEESE_VERSION="$(p:version "$CLONE")"
  CHEESE_COMMIT="$(p:commit "$CLONE")"

  echo "==> Releasing packages"
  echo "-> dotfiles $DOTFILES_VERSION ($DOTFILES_COMMIT)"
  echo "-> cipher $CIPHER_VERSION ($CIPHER_COMMIT)"
  echo "-> cheese $CHEESE_VERSION ($CHEESE_COMMIT)"

  # Clean up build artifacts from previous release.
  rm -rf "$DIST" && cp -r "$PUBLIC" "$DIST"

  release:homebrew
  release:arch
  release:debian

  if prompt -y "Push release to production?"; then
    git add arch Formula

    if ! git diff --cached --quiet; then
      git commit -m "Release dotfiles/$DOTFILES_VERSION cipher/$CIPHER_VERSION cheese/$CHEESE_VERSION"
    fi

    git push
    lift deploy -y
  fi
}

release:homebrew() {
  setup

  echo "-> homebrew"

  for SPEC in "${SOURCES[@]}"; do
    IFS=: read -r SOURCE REMOTE CLONE <<< "$SPEC"

    VERSION="$(p:version "$CLONE")"
    TARBALL="$SOURCE-$VERSION.tar.gz"

    git -C "$CLONE" archive \
      --prefix="$SOURCE-$VERSION/" HEAD | gzip -n > "$DIST/$TARBALL"

    ARCHIVE_URL="${URL}/${TARBALL}"
    SHA="$(openssl dgst -sha256 "$DIST/$TARBALL" | awk '{print $2}')"

    for f in Formula/*.rb; do
      SOURCE_FILE="${f%.rb}.source"
      [ -f "$SOURCE_FILE" ] || err "missing source for Homebrew formula '$f'"
      [ "$(cat "$SOURCE_FILE")" = "$SOURCE" ] || continue

      awk \
        -v url="$ARCHIVE_URL" -v sha="$SHA" -v ver="$VERSION" \
        '/^  url / { print "  url \"" url "\""; next }
         /^  sha256 / { print "  sha256 \"" sha "\""; next }
         /^  version / { print "  version \"" ver "\""; next }
         { print }' \
        "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    done
  done
}

manifest:gentoo() {
  required pkgdev

  echo "-> gentoo"

  for pkg in *-*/*/; do
    (cd "$pkg" && pkgdev manifest)
  done
}

release:arch() {
  required makepkg
  required repo-add

  setup

  echo "-> arch"

  # Clean up build artifacts from previous release.
  try chmod -R u+rwx "$CACHE/makepkg-build"
  rm -rf "$CACHE/makepkg-build"

  mkdir -p "$DIST/arch/any" "$CACHE/makepkg-src" "$CACHE/makepkg-build"

  flags=(--noconfirm --nodeps --clean --cleanbuild --sign --key "$SIGNING_KEY")

  if [ "$(uname)" = "Darwin" ]; then
    echo 'PKGEXT=".pkg.tar.zst"' > "$CACHE/makepkg.conf"
    echo 'SRCEXT=".src.tar.gz"' >> "$CACHE/makepkg.conf"
    echo 'BUILDENV=(color)' >> "$CACHE/makepkg.conf"

    flags+=(--config "$CACHE/makepkg.conf")
  fi

  # Export the signing key for the dupunkto-keyring package.
  gpg --export "$SIGNING_KEY" > arch/dupunkto-keyring/dupunkto.gpg

  echo "# $PACKAGER" > arch/dupunkto-keyring/dupunkto-trusted
  echo "$SIGNING_KEY:4:" >> arch/dupunkto-keyring/dupunkto-trusted

  # Publish the signing key for the manual pacman-key trust path.
  gpg --armor --export "$SIGNING_KEY" > "$DIST/keyring.asc"

  for pkg in arch/*/; do
    NAME="$(basename "$pkg")"

    (
      cd "$pkg"
      export BUILDDIR="$CACHE/makepkg-build/$NAME"
      export SRCDEST="$CACHE/makepkg-src"
      export PKGDEST="$DIST/arch/any"

      makepkg "${flags[@]}"
    )
  done

  repo-add -s -k "$SIGNING_KEY" \
    "$DIST/arch/any/dupunkto.db.tar.gz" \
    "$DIST"/arch/any/*.pkg.tar.zst
}

release:debian() {
  required dpkg-deb
  required dpkg-scanpackages

  setup

  echo "-> debian"

  mkdir -p "$DIST/debian/pool"

  for pkg in debian/*/; do
    NAME="$(basename "$pkg")"
    STAGING="$DIST/debian/staging/$NAME"

    [ -f "$pkg/source" ] || err "missing source for '$NAME'"

    p:use "$(cat "$pkg/source")"
    VERSION="$(p:version "$CLONE")"

    rm -rf "$STAGING" && mkdir -p "$STAGING/DEBIAN" "$STAGING/usr/bin"

    while IFS=' ' read -r src_file dst_name; do
      install -Dm755 "$CLONE/$src_file" "$STAGING/usr/bin/$dst_name"
    done < "$pkg/files"

    sed "s/^Version:.*/Version: ${VERSION#r}-1/" "$pkg/control" \
      > "$STAGING/DEBIAN/control"

    dpkg-deb --root-owner-group --build "$STAGING" \
      "$DIST/debian/pool/${NAME}_${VERSION}_all.deb"
  done

  rm -rf "$DIST/debian/staging"

  STABLE="$DIST/debian/dists/stable"
  REL="main/binary-all/Packages.gz"

  mkdir -p "$(dirname "$STABLE/$REL")"

  (cd "$DIST/debian" && dpkg-scanpackages pool/) | gzip -9 > "$STABLE/$REL"

  SIZE=$(wc -c < "$STABLE/$REL")
  MD5=$(openssl dgst -md5 "$STABLE/$REL" | awk '{print $2}')
  SHA256=$(openssl dgst -sha256 "$STABLE/$REL" | awk '{print $2}')

  cat > "$STABLE/Release" <<EOF
Origin: dupunkto
Label: dupunkto
Suite: stable
Codename: stable
Architectures: all
Components: main
Date: $(date -u '+%a, %d %b %Y %H:%M:%S UTC')
MD5Sum:
 $MD5 $SIZE $REL
SHA256:
 $SHA256 $SIZE $REL
EOF
}
